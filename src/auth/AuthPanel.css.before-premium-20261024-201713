.auth-page {
  min-height: 75vh;
  display: grid;
  place-items: center;
  padding: 24px 16px;
}

.auth-card {
  width: 100%;
  max-width: 420px;
  padding: 26px;
  border: 1px solid rgba(148, 163, 184, .25);
  border-radius: 24px;
  background: var(--card-bg, #111827);
  color: var(--text-color, #f8fafc);
  box-shadow: 0 18px 55px rgba(0, 0, 0, .18);
}

.auth-logo {
  font-size: 42px;
  text-align: center;
}

.auth-card h1 {
  text-align: center;
  margin: 8px 0;
}

.auth-subtitle,
.auth-footnote {
  text-align: center;
  opacity: .75;
  font-size: .9rem;
  line-height: 1.6;
}

.auth-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: 24px 0 18px;
}

.auth-switch button,
.auth-submit {
  min-height: 44px;
  border: 1px solid rgba(148, 163, 184, .35);
  border-radius: 12px;
  padding: 10px;
  cursor: pointer;
}

.auth-switch button.selected,
.auth-submit {
  background: #2563eb;
  color: white;
  border-color: #2563eb;
}

.auth-form {
  display: grid;
  gap: 16px;
}

.auth-form label {
  display: grid;
  gap: 7px;
  font-size: .95rem;
}

.auth-form input {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 12px;
  border: 1px solid #64748b;
  border-radius: 10px;
  background: #fff;
  color: #111827;
  font-size: 16px;
}

.auth-submit:disabled {
  opacity: .65;
  cursor: wait;
}

.auth-message {
  padding: 12px;
  margin-top: 16px;
  border-radius: 10px;
  background: rgba(37, 99, 235, .14);
  overflow-wrap: anywhere;
  line-height: 1.5;
}
