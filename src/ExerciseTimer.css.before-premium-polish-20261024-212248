.exercise-card, .music-card {
  margin: 18px 0;
  padding: 20px;
  border: 1px solid #293b53;
  border-radius: 20px;
  background: linear-gradient(145deg, #111e30, #0b1422);
  color: #e9f1ff;
}
.exercise-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}
.exercise-heading > span { font-size: 30px; }
.exercise-heading h2, .exercise-history h3, .music-card h2 { margin: 0 0 5px; }
.exercise-heading p, .exercise-history p { margin: 0; color: #9aabc5; font-size: 13px; }
.exercise-label { display: block; margin: 12px 0; color: #a9bbd5; font-size: 13px; }
.exercise-card select, .exercise-card input, .music-card input[type="file"] {
  box-sizing: border-box;
  width: 100%;
  margin-top: 7px;
  padding: 12px;
  border-radius: 11px;
  border: 1px solid #30435e;
  background: #0d1626;
  color: #e9f1ff;
}
.exercise-mode, .exercise-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}
.exercise-card button, .music-card button {
  border: 1px solid #30435e;
  border-radius: 11px;
  padding: 11px 13px;
  background: #1a2940;
  color: #e9f1ff;
  font-weight: 700;
}
.exercise-mode button, .exercise-actions button { flex: 1; }
.exercise-card button.active, .exercise-actions button:first-child {
  background: linear-gradient(120deg, #16b994, #3c8dff);
  color: #06141b;
  border: 0;
}
.exercise-card button.finish { background: #26354a; color: #e9f1ff; }
.exercise-card button:disabled { opacity: .4; }
.exercise-clock {
  margin: 22px 0 8px;
  text-align: center;
  font-size: clamp(32px, 10vw, 48px);
  font-weight: 800;
  letter-spacing: 2px;
  color: #54edb9;
  font-variant-numeric: tabular-nums;
}
.exercise-status { text-align: center; color: #9aabc5; font-size: 13px; }
.exercise-history { margin-top: 24px; }
.exercise-history h3 { margin-bottom: 12px; }
.exercise-session {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #29384e;
}
.exercise-session small { display: block; margin-top: 4px; color: #9aabc5; }
.exercise-session strong { color: #54edb9; font-variant-numeric: tabular-nums; }
