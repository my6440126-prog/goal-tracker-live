.music-title { display: flex; align-items: center; gap: 12px; }
.music-title > span { font-size: 30px; }
.music-title p { margin: 0; color: #9aabc5; font-size: 13px; }
.music-pick {
  display: block;
  margin: 18px 0;
  padding: 12px;
  border: 1px dashed #53647e;
  border-radius: 12px;
  text-align: center;
  color: #54edb9;
  cursor: pointer;
}
.music-pick input { display: block; width: 100%; margin-top: 10px; color: #a9bbd5; }
.music-art {
  display: grid;
  place-items: center;
  width: 118px;
  height: 118px;
  margin: 22px auto 14px;
  border-radius: 24px;
  background: linear-gradient(145deg, #283b66, #542d78);
  color: #b6a7ff;
  font-size: 60px;
  box-shadow: 0 10px 35px #0003;
}
.music-track { text-align: center; overflow-wrap: anywhere; margin: 10px 0 4px; }
.music-subtitle { text-align: center; color: #9aabc5; font-size: 13px; }
.music-progress { display: block; width: 100%; accent-color: #54edb9; margin-top: 20px; }
.music-time { display: flex; justify-content: space-between; color: #9aabc5; font-size: 12px; }
.music-controls { display: flex; justify-content: center; align-items: center; gap: 16px; margin: 18px 0; }
.music-card button {
  border: 1px solid #30435e;
  border-radius: 12px;
  padding: 11px 14px;
  background: #1a2940;
  color: #e9f1ff;
}
.music-card button:disabled { opacity: .35; }
.music-card button.music-play {
  min-width: 105px;
  background: linear-gradient(120deg, #16b994, #3c8dff);
  color: #06141b;
  border: 0;
}
.music-list { display: grid; gap: 7px; margin-top: 18px; }
.music-list button { display: flex; justify-content: space-between; gap: 10px; text-align: left; }
.music-list button.selected { border-color: #54edb9; color: #54edb9; }
.music-list button span:first-child { overflow-wrap: anywhere; }
.music-note { margin-top: 18px; color: #9aabc5; font-size: 12px; line-height: 1.5; }

.music-shuffle {
  display: block;
  margin: 0 auto 18px;
  min-width: 150px;
}
.music-card button.music-shuffle.active {
  background: #164b42;
  border-color: #54edb9;
  color: #54edb9;
}
.music-playlist-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-top: 22px;
}
.music-playlist-heading h3 { margin: 0; }
.music-playlist-heading span,
.music-empty { color: #9aabc5; font-size: 13px; }
.music-list-row {
  display: flex;
  align-items: stretch;
  gap: 7px;
}
.music-list-row.selected {
  border: 1px solid #54edb9;
  border-radius: 12px;
}
.music-list-row .music-track-select {
  display: flex;
  flex: 1;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  min-width: 0;
  text-align: left;
  border: 0;
  background: transparent;
}
.music-track-select span:first-child { overflow-wrap: anywhere; }
.music-list-row .music-remove {
  align-self: center;
  padding: 8px 11px;
  color: #ff9b9b;
  background: transparent;
  border: 0;
}
.music-empty { text-align: center; padding: 14px 0; }
